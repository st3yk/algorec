load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "items",
    srcs = [
        "__init__.py",
        "items.py",
    ],
)

py_library(
    name = "registry",
    srcs = ["registry.py"],
)

py_library(
    name = "targets",
    srcs = ["targets.py"],
    deps = [
        ":items",
        ":registry",
    ],
)

py_library(
    name = "assembler",
    srcs = ["assembler.py"],
    deps = [
        ":items",
        ":registry",
        ":targets",
        "@pypi//numpy",
        "@pypi//scipy",
    ],
)

py_library(
    name = "synthetic",
    srcs = ["synthetic.py"],
    deps = [
        ":items",
        ":registry",
    ],
)

py_library(
    name = "demo_lib",
    srcs = ["demo.py"],
    deps = [
        ":assembler",
        ":registry",
        ":synthetic",
        ":targets",
    ],
)

py_binary(
    name = "demo",
    srcs = ["demo.py"],
    main = "demo.py",
    deps = [
        ":assembler",
        ":registry",
        ":synthetic",
        ":targets",
    ],
)
