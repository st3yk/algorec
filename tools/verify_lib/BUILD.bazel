load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "verify_lib",
    srcs = glob(
        ["*.py"],
        exclude = ["*_selftest.py"],
    ),
    data = ["docs_map.json"],
    deps = ["//tools/proto_compat:listing"],
)

py_test(
    name = "selftest",
    size = "small",
    srcs = ["verify_selftest.py"],
    main = "verify_selftest.py",
    deps = [
        ":verify_lib",
        "@pypi//pytest",
    ],
)

filegroup(
    name = "py_srcs",
    srcs = glob(["*.py"]),
)

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["**/__pycache__/**"],
    ),
    visibility = ["//:__pkg__"],
)
