#!/usr/bin/env bash
set -uo pipefail
repo="$(git rev-parse --show-toplevel)"
"$repo/tools/verify"
code=$?
case "$code" in
  0) exit 0 ;;
  2) echo "pre-push: NEEDS_HUMAN. Pushing is allowed; the PR must stay a draft until a human accepts it." >&2; exit 0 ;;
  *) echo "pre-push: tools/verify says FAIL or ERROR (exit $code). Fix it before pushing." >&2; exit 1 ;;
esac
