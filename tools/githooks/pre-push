#!/usr/bin/env bash
set -uo pipefail
head="$(git rev-parse HEAD)"
if [[ "${STEERREC_OPEN_PR:-}" != 1 ]]; then
  echo "pre-push: push with tools/agent/open_pr.sh <slug>; it runs the trusted gate first." >&2
  echo "pre-push: (a human who knows better can run STEERREC_OPEN_PR=1 before the push)" >&2
  exit 1
fi
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/master | refs/heads/main)
      echo "pre-push: pushing to $remote_ref is not allowed; open a PR from a feat/* branch." >&2
      exit 1
      ;;
  esac
  if [[ "$local_sha" != 0000000000000000000000000000000000000000 && "$local_sha" != "$head" ]]; then
    echo "pre-push: push the branch you have checked out, so the gate judged what you push ($local_ref)." >&2
    exit 1
  fi
done
exit 0
