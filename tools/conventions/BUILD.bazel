load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "conventions",
    srcs = ["conventions.py"],
)

py_test(
    name = "test",
    size = "small",
    srcs = ["conventions_test.py"],
    args = ["$(rootpaths //:repo_files)"],
    data = ["//:repo_files"],
    main = "conventions_test.py",
    deps = [":conventions"],
)

py_test(
    name = "selftest",
    size = "small",
    srcs = ["conventions_selftest.py"],
    data = [
        "//:conftest.py",
        "//:pytest.ini",
    ],
    main = "conventions_selftest.py",
    deps = [
        ":conventions",
        "@pypi//pytest",
    ],
)

filegroup(
    name = "py_srcs",
    srcs = glob(["*.py"]),
)

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["**/__pycache__/**"],
    ),
    visibility = ["//:__pkg__"],
)
