load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "hooks",
    srcs = glob(
        ["*.py"],
        exclude = ["*_selftest.py"],
    ),
    deps = [
        "//tools/conventions",
        "//tools/verify_lib",
    ],
)

py_test(
    name = "selftest",
    size = "small",
    srcs = ["hooks_selftest.py"],
    data = [
        "//:conftest.py",
        "//:pytest.ini",
    ],
    main = "hooks_selftest.py",
    deps = [
        ":hooks",
        "@pypi//pytest",
    ],
)

filegroup(
    name = "py_srcs",
    srcs = glob(["*.py"]),
)

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["**/__pycache__/**"],
    ),
    visibility = ["//:__pkg__"],
)
