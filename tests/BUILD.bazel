load("@rules_python//python:py_test.bzl", "py_test")

py_test(
    name = "test_toolchain",
    size = "small",
    srcs = ["test_toolchain.py"],
    deps = [
        "@pypi//pytest",
        "@pypi//scipy",
    ],
)

py_test(
    name = "test_model",
    size = "small",
    srcs = ["test_model.py"],
    deps = [
        "//steerrec:items",
        "//steerrec:registry",
        "@pypi//numpy",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_targets",
    size = "small",
    srcs = ["test_targets.py"],
    deps = [
        "//steerrec:items",
        "//steerrec:registry",
        "//steerrec:targets",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_assembler",
    size = "small",
    srcs = ["test_assembler.py"],
    data = ["//:pytest.ini"],
    env = {"PYTEST_ADDOPTS": "-m 'not slow and not timing'"},
    main = "test_assembler.py",
    deps = [
        "//steerrec:assembler",
        "//steerrec:items",
        "//steerrec:registry",
        "//steerrec:synthetic",
        "//steerrec:targets",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_assembler_slow",
    size = "medium",
    srcs = ["test_assembler.py"],
    data = ["//:pytest.ini"],
    env = {"PYTEST_ADDOPTS": "-m 'slow'"},
    main = "test_assembler.py",
    tags = ["slow"],
    deps = [
        "//steerrec:assembler",
        "//steerrec:items",
        "//steerrec:registry",
        "//steerrec:synthetic",
        "//steerrec:targets",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_assembler_timing",
    size = "small",
    srcs = ["test_assembler.py"],
    data = ["//:pytest.ini"],
    env = {"PYTEST_ADDOPTS": "-m 'timing'"},
    main = "test_assembler.py",
    tags = [
        "exclusive",
        "timing",
    ],
    deps = [
        "//steerrec:assembler",
        "//steerrec:items",
        "//steerrec:registry",
        "//steerrec:synthetic",
        "//steerrec:targets",
        "@pypi//pytest",
    ],
)

